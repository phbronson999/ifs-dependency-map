fragment OrderLinesFragment;
component SHPORD;
layer Core;
description "Order lines list";

----------------------------- CLIENT FRAGMENTS ------------------------------

list OrderLinesList for OrderLine {
   field LineNo;
   field PartNo;
}

--------------------------- PROJECTION FRAGMENTS ----------------------------

entity OrderLine {
   crud = Read;
   from = "shop_order_line";
   keys = OrderNo, LineNo;
   attribute OrderNo Text;
   attribute LineNo Number;
   attribute PartNo Text;
   attribute Contract Text;
   -- Not included here: the projection that includes this fragment brings it in.
   reference ContractRef(Contract) to UserAllowedSiteLov(Contract);

   -- Same name as the action bound to ShopOrder; bound actions are scoped to their entity.
   action PrintOrder;
}
