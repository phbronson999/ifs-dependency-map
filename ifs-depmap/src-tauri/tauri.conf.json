{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IFS Dependency Map",
  "version": "0.5.0",
  "identifier": "dev.bronson.ifsdepmap",
  "build": {
    "frontendDist": "../ui/dist",
    "beforeDevCommand": "node ui/build.mjs",
    "beforeBuildCommand": "node ui/build.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "IFS Dependency Map",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"]
  }
}
